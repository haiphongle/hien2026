# Optional production settings for a dashboard talking to a local backend.
# During development, leave these unset to use the Vite proxy.
VITE_API_BASE_URL=http://127.0.0.1:8100
VITE_WS_BASE_URL=ws://127.0.0.1:8100

# Optional public model catalog. The default is the planned FrameWeaver repo.
# Set this to a published raw JSON URL to override the source.
VITE_MODEL_CATALOG_URL=

# Never put provider keys or passwords in VITE_* variables: they reach browsers.
