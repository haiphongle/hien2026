# Copy to .env and load into your shell before starting the backend.
# The backend reads environment variables; it does not automatically load .env.
FLOW_PROJECT_ID=
API_HOST=127.0.0.1
API_PORT=8100
WS_HOST=127.0.0.1
WS_PORT=9222
FLOW_ALLOW_DEGRADED=0

# Optional services: use your own keys and keep .env private.
ANTHROPIC_API_KEY=
SUNO_API_KEY=
